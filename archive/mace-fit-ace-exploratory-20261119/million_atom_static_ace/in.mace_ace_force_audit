# Million-atom static force distribution audit; no integration.
units metal
atom_style atomic
boundary p p f
read_data /workspace/-/models/ag_ti3sic2_qsgs_1to1/ag_ti3sic2_qsgs.data.gz
pair_style pace
pair_coeff * * /workspace/potential-comparison/mace_fit_data_20261118/sensitivity_Ti_gap_weight/AgCSiTi_B1616_E10000_F1_a0.001_Ti_gap_weight0.05.yace Ti Si C Ag
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
variable gt05 atom v_fmag > 0.5
variable gt1 atom v_fmag > 1.0
variable gt5 atom v_fmag > 5.0
compute fmax all reduce max v_fmag
compute n05 all reduce sum v_gt05
compute n1 all reduce sum v_gt1
compute n5 all reduce sum v_gt5
group Ti type 1
group Si type 2
group C type 3
group Ag type 4
compute n05Ti Ti reduce sum v_gt05
compute n05Si Si reduce sum v_gt05
compute n05C C reduce sum v_gt05
compute n05Ag Ag reduce sum v_gt05
thermo 1
thermo_style custom step atoms pe c_fmax c_n05 c_n1 c_n5 c_n05Ti c_n05Si c_n05C c_n05Ag
dump hot all custom 1 force_hotspots.lammpstrj id type x y z v_fmag fx fy fz
dump_modify hot sort id thresh v_fmag > 0.5
run 0
print "MACE_ACE_MILLION_FORCE_AUDIT_COMPLETE"
