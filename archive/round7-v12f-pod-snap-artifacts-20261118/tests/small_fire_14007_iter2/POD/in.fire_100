clear
units metal
atom_style atomic
boundary f f f
atom_modify sort 0 0
read_data /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/small_fire_14007/POD/minimized.data
pair_style pod
pair_coeff * * /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/POD/AgTiSiC_POD_v12f.pod /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/POD/pod_v12f_coefficients.pod Ag C Si Ti
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
region xlo block 0 7 INF INF INF INF units box
region xhi block 43 50 INF INF INF INF units box
region ylo block INF INF 0 7 INF INF units box
region yhi block INF INF 43 50 INF INF units box
group gxlo region xlo
group gxhi region xhi
group gylo region ylo
group gyhi region yhi
group side union gxlo gxhi gylo gyhi
fix rim side setforce 0.0 0.0 0.0
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute fmax all reduce max v_fmag
thermo 10
thermo_style custom step atoms pe c_fmax
thermo_modify lost error flush yes format float %.16g
min_style fire
min_modify dmax 0.02
minimize 0.0 0.2 100 2000
write_dump all custom /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/small_fire_14007_iter2/POD/forces_minimized.dump id type x y z fx fy fz modify sort id
write_data /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/small_fire_14007_iter2/POD/minimized.data
