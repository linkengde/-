clear
units metal
atom_style atomic
boundary p p m
processors 1 1 1
read_data /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/Ag_Ti3SiC2_bicontinuous_200x200x300.data
group src_Ti type 1
group src_Si type 2
group src_C type 3
group src_Ag type 4
set group src_Ti type 4
set group src_Si type 3
set group src_C type 2
set group src_Ag type 1
mass 1 107.8682
mass 2 12.011
mass 3 28.085
mass 4 47.867
pair_style pod
pair_coeff * * /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/POD/AgTiSiC_POD_v12f.pod /workspace/potential-fit/round7_pod_snap/models/v12_candidate_forceorder_fixed/POD/pod_v12f_coefficients.pod Ag C Si Ti
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute fmax all reduce max v_fmag
group ag type 1
group carbon type 2
group silicon type 3
group titanium type 4
compute fmax_ag ag reduce max v_fmag
compute fmax_c carbon reduce max v_fmag
compute fmax_si silicon reduce max v_fmag
compute fmax_ti titanium reduce max v_fmag
thermo 1
thermo_style custom step atoms pe c_fmax c_fmax_ag c_fmax_c c_fmax_si c_fmax_ti
thermo_modify lost error flush yes
run 0
write_dump all custom /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/static_screen_v12f/forces.dump id type x y z fx fy fz modify sort id
