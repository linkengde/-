clear
units metal
atom_style atomic
boundary p p p
read_data /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/evaluation_runs/POD/frame_0009/config.data
pair_style pod
pair_coeff * * /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/AgTiSiC_POD.pod /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/pod_coefficients.pod Ag C Si Ti
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute fmax all reduce max v_fmag
thermo 1
thermo_style custom step atoms pe c_fmax
thermo_modify lost error flush yes format float %.16g
run 0
print "ENERGY $(pe:%.17g)" file /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/evaluation_runs/POD/frame_0009/energy.txt screen no
write_dump all custom /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/evaluation_runs/POD/frame_0009/forces.dump id fx fy fz modify sort id
