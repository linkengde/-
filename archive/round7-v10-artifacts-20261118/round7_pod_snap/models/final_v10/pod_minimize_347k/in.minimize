clear
units metal
atom_style atomic
boundary p p m
atom_modify sort 0 0
read_data /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs/md_runs/attempt_008_POD_TTM_mpi_big/start_wrapped.data
group source_Ti type 1
group source_Si type 2
group source_C type 3
group source_Ag type 4
set group source_Ti type 4
set group source_Si type 3
set group source_C type 2
set group source_Ag type 1
mass 1 107.8682
mass 2 12.011
mass 3 28.085
mass 4 47.867
pair_style pod
pair_coeff * * /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/AgTiSiC_POD.pod /workspace/potential-fit/round7_pod_snap/models/final_v10/POD/pod_coefficients.pod Ag C Si Ti
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
region fixed_z block INF INF INF INF 0 20 units box
group bottom_z region fixed_z
group skeleton union source_Ti source_Si source_C
group fixed intersect bottom_z skeleton
group mobile subtract all fixed
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute fmax all reduce max v_fmag
compute fmax_mobile mobile reduce max v_fmag
compute fmax_fixed fixed reduce max v_fmag
thermo 10
thermo_style custom step atoms pe etotal c_fmax c_fmax_mobile c_fmax_fixed
thermo_modify lost error flush yes format float %.16g
run 0
fix hold fixed setforce 0.0 0.0 0.0
min_style fire
min_modify dmax 0.1
minimize 0.0 0.3 1000 5000
unfix hold
run 0
print "FINAL $(pe:%.16g) $(c_fmax:%.16g) $(c_fmax_mobile:%.16g) $(c_fmax_fixed:%.16g)" file /workspace/potential-fit/round7_pod_snap/models/final_v10/pod_minimize_347k/final_metrics.txt screen no
dump d all custom 1 /workspace/potential-fit/round7_pod_snap/models/final_v10/pod_minimize_347k/minimized.dump id type x y z fx fy fz
dump_modify d sort id
write_data /workspace/potential-fit/round7_pod_snap/models/final_v10/pod_minimize_347k/minimized.data
