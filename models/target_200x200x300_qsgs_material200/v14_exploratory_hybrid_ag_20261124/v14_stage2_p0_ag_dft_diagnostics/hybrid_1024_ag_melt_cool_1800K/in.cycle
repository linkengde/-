clear
units metal
atom_style atomic
boundary p p p
atom_modify sort 0 0
read_data /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/v13_source_and_fit_20261123/v14_stage2_p0_ag_dft_diagnostics/hybrid_1024_ag_melt_cool/ideal_interface_4x4x1_1024.data
mass 1 107.8682
mass 2 12.011
mass 3 28.0855
mass 4 47.867
group silver type 1
group skeleton type 2 3 4
pair_style hybrid/overlay eam tersoff morse 8.0 zbl 1.5 2.4
pair_coeff 1 1 eam /workspace/-/models/ag_ti3sic2_qsgs_1to1_finer/potentials/Ag_u3.eam
pair_coeff * * tersoff /workspace/-/models/ag_ti3sic2_qsgs_1to1_finer/potentials/TSCBOP.tersoff NULL C Si Ti
pair_coeff 1 2 morse 0.020000 7.804451 1.400000 8.0
pair_coeff 1 3 morse 0.020000 3.107766 1.400605 8.0
pair_coeff 1 4 morse 0.678644 1.155035 2.989514 8.0
pair_coeff 1 2 zbl 47 6
pair_coeff 1 3 zbl 47 14
pair_coeff 1 4 zbl 47 22
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute fmax all reduce max v_fmag
thermo 50
thermo_style custom step time temp pe press c_fmax
min_style fire
min_modify dmax 0.05
minimize 1.0e-8 1.0e-3 2000 20000
write_dump all custom /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/v13_source_and_fit_20261123/v14_stage2_p0_ag_dft_diagnostics/hybrid_1024_ag_melt_cool/minimized_initial.dump id type x y z fx fy fz modify sort id
write_data /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/v13_source_and_fit_20261123/v14_stage2_p0_ag_dft_diagnostics/hybrid_1024_ag_melt_cool/after_fire.data
reset_timestep 0
compute TAg silver temp
compute TSkel skeleton temp
compute MSDAg silver msd com yes
thermo_style custom step time temp c_TAg c_TSkel c_MSDAg[4] pe ke etotal press c_fmax
velocity silver create 300.0 24601 mom yes rot yes dist gaussian
velocity skeleton create 300.0 24602 mom yes rot yes dist gaussian
fix sink skeleton nvt temp 300.0 300.0 0.1
fix equil silver nvt temp 300.0 300.0 0.1
timestep 0.001
dump tr all custom 50 /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/v13_source_and_fit_20261123/v14_stage2_p0_ag_dft_diagnostics/hybrid_1024_ag_melt_cool/cycle.dump id type x y z vx vy vz fx fy fz
dump_modify tr sort id
run 200
unfix equil
fix heat silver nvt temp 300.0 1800.0 0.1
run 500
unfix heat
fix hold silver nvt temp 1800.0 1800.0 0.1
run 1000
unfix hold
fix cool silver nvt temp 1800.0 300.0 0.1
run 1500
unfix cool
fix final silver nvt temp 300.0 300.0 0.1
run 500
write_data /workspace/potential-fit/round7_pod_snap/models/target_200x200x300_qsgs_material200/v13_source_and_fit_20261123/v14_stage2_p0_ag_dft_diagnostics/hybrid_1024_ag_melt_cool/after_cycle.data
