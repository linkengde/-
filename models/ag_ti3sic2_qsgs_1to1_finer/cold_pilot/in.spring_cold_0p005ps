# Short no-source spring-constraint comparison; set K with `-var K 1` or `10`.
units metal
atom_style atomic
boundary p p f
read_data ag_ti3sic2_qsgs.data.gz
include potential.interface_calibration_v0.inc
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
region r_bottom block INF INF INF INF 0.0 20.0 units box
region r_bath block INF INF INF INF 20.0 40.0 units box
group bottom region r_bottom
group bath region r_bath
group skeleton type 1 2 3
group ag type 4
group mobile subtract all bottom
group mobile_skeleton subtract skeleton bottom
group mobile_ag subtract ag bottom
fix freeze bottom setforce 0.0 0.0 0.0
# Initialize the same fixed-scaffold Ag-relaxed coordinates for both K values.
read_dump cold_pilot/ag_only_fire_mobile_step200.dump.gz 200 x y z box no replace yes
reset_timestep 0
fix skeleton_spring mobile_skeleton spring/self ${K}
fix_modify skeleton_spring energy yes
variable fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute f_mobile mobile reduce max v_fmag
compute f_ag mobile_ag reduce max v_fmag
compute f_skeleton mobile_skeleton reduce max v_fmag
compute t_mobile mobile temp
compute t_ag mobile_ag temp
compute t_skeleton mobile_skeleton temp
compute t_bath bath temp
compute disp_ag mobile_ag displace/atom
compute disp_skeleton mobile_skeleton displace/atom
compute maxdisp_ag mobile_ag reduce max c_disp_ag[4]
compute maxdisp_skeleton mobile_skeleton reduce max c_disp_skeleton[4]
thermo 50
thermo_style custom step time c_t_mobile c_t_ag c_t_skeleton c_t_bath pe ke etotal c_f_mobile c_f_ag c_f_skeleton c_maxdisp_ag c_maxdisp_skeleton
thermo_modify temp t_mobile flush yes
velocity mobile create 300.0 319877 mom yes rot no dist gaussian
timestep 0.0001
fix integrate mobile nve
fix thermostat bath langevin 300.0 300.0 0.1 827331
fix_modify thermostat temp t_bath
dump cold_ag mobile_ag custom 50 cold_pilot/traj_mobile_ag_springK${K}.dump id type x y z vx vy vz
dump_modify cold_ag sort id
run 50
# Remove thermostat, integrator, and artificial spring to measure pair forces.
unfix thermostat
unfix integrate
unfix skeleton_spring
thermo_style custom step pe c_f_ag c_f_skeleton c_maxdisp_ag c_maxdisp_skeleton
thermo_modify flush yes
run 0
undump cold_ag
write_dump mobile_ag custom cold_pilot/final_mobile_ag_springK${K}.dump id type x y z vx vy vz modify sort id
print "SPRING_K=${K}_COLD_NO_SOURCE_0P005PS_DONE"
