[BISPECTRUM]
numTypes = 4
twojmax = 4 4 4 4
rcutfac = 1.0
rfac0 = 0.99363
rmin0 = 0.0
wj = 1.0 1.0 1.0 1.0
radelem = 2.5 2.5 2.5 2.5
type = Ag C Si Ti
wselfallflag = 0
chemflag = 1
bnormflag = 1
bzeroflag = 0
quadraticflag = 0

[CALCULATOR]
calculator = LAMMPSSNAP
energy = 1
force = 1
stress = 0

[ESHIFT]
Ag = 0.0
C = 0.0
Si = 0.0
Ti = 0.0

[SOLVER]
solver = SVD
compute_testerrs = 1
detailed_errors = 1

[SCRAPER]
scraper = xyz

[PATH]
dataPath = data

[OUTFILE]
metrics = SNAP_v12q_metrics.md
potential = AgTiSiC_SNAP_v12q

[REFERENCE]
units = metal
atom_style = atomic
pair_style = zero 8.0
pair_coeff = * *

[GROUPS]
group_sections = name training_size testing_size eweight fweight vweight
group_types = str float float float float float
smartweights = 0
random_sampling = 0
Train = 1.0 0.0 100.0 1.0 0.0
Local = 1.0 0.0 0.0 10.0 0.0
Validation = 0.0 1.0 1.0 1.0 0.0

[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0

[MEMORY]
override = 0
