LAYER_AUDIT overlap_fixed_bath=0 overlap_fixed_newton=0 overlap_bath_newton=0 material_unassigned=0 solid_outside_material=0

# Run-zero only, reporting unmasked conservative forces.
variable fn atom sqrt(fx*fx+fy*fy+fz*fz)
compute fmax_all all reduce max v_fn
compute fmax_fixed fixed reduce max v_fn
compute fmax_bath bath reduce max v_fn
compute fmax_newton newton reduce max v_fn
thermo 1
thermo_style custom step atoms pe fmax c_fmax_all c_fmax_fixed c_fmax_bath c_fmax_newton
run 0
