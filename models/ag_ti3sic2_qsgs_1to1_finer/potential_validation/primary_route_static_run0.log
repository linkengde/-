# Layer definitions for the selected Ag-Ti3SiC2 QSGS geometry.
# Static-only audit: no integration, thermostat, TTM, or heat source.
units metal
atom_style atomic
boundary p p f
read_data ag_ti3sic2_qsgs.data.gz
