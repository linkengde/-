# Continue static Ag-only relaxation from the archived 100-FIRE-step endpoint.
# Keep Ti3SiC2 rigid; no dynamics, thermostat, TTM, or heat source.
units metal
atom_style atomic
boundary p p f
read_data potential_validation/relaxed_backbone_candidate/ag_ti3sic2_qsgs.data.gz
read_dump potential_validation/relaxed_backbone_candidate/ag_only_rigid_skeleton_100.dump.gz 100 x y z box no replace yes
include potential.interface_calibration_v0.inc
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
region r_bottom block INF INF INF INF 0.0 20.0 units box
group bottom region r_bottom
group Ag type 4
group skeleton type 1 2 3
group moving_Ag subtract Ag bottom
group moving_skeleton subtract skeleton bottom
fix freeze_bottom bottom setforce 0.0 0.0 0.0
fix freeze_skeleton skeleton setforce 0.0 0.0 0.0
variable fn atom sqrt(fx*fx+fy*fy+fz*fz)
compute f_Ag moving_Ag reduce max v_fn
compute f_skeleton moving_skeleton reduce max v_fn
thermo 20
thermo_style custom step atoms pe press c_f_Ag c_f_skeleton
thermo_modify flush yes
min_style fire
min_modify dmax 0.002
minimize 1.0e-7 0.05 200 4000
unfix freeze_skeleton
run 0
write_dump all custom potential_validation/relaxed_backbone_candidate/ag_only_rigid_skeleton_continue_200.dump id type x y z fx fy fz modify sort id
print "AG_ONLY_RIGID_SKELETON_CONTINUE_200_DONE"
