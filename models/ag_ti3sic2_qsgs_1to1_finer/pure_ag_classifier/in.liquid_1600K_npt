units metal
atom_style atomic
boundary p p p
lattice fcc 4.09
region box block 0 10 0 10 0 10 units lattice
create_box 1 box
create_atoms 1 box
mass 1 107.8682
pair_style eam
pair_coeff * * ../potentials/Ag_u3.eam
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0005
velocity all create 1600.0 871039 mom yes rot no dist gaussian
compute cna all cna/atom 3.35
compute disp all displace/atom
dump d all custom 1000 dump.liquid_1600K_npt id type x y z c_cna c_disp[4]
dump_modify d sort id
fix npt all npt temp 1600.0 1600.0 0.1 iso 0.0 0.0 1.0
thermo 1000
thermo_style custom step time temp pe ke etotal press
run 20000
write_data data.liquid_1600K_npt
