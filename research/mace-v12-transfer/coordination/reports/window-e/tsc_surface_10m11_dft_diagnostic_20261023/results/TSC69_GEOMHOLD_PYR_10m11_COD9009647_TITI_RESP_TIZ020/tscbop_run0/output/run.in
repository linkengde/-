clear
units metal
atom_style atomic
boundary p p p
read_data /tmp/e-tsc69-fresh/research/mace-v12-transfer/coordination/reports/window-e/tsc_surface_10m11_dft_diagnostic_20261023/results/TSC69_GEOMHOLD_PYR_10m11_COD9009647_TITI_RESP_TIZ020/tscbop_run0/output/atoms.data
pair_style tersoff
pair_coeff * * /tmp/e-tsc69-fresh/research/mace-v12-transfer/coordination/reports/window-e/tsc_surface_10m11_dft_diagnostic_20261023/results/TSC69_GEOMHOLD_PYR_10m11_COD9009647_TITI_RESP_TIZ020/tscbop_run0/output/TSCBOP.source.tersoff Ti Si C
